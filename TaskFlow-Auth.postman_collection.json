{
  "info": {
    "name": "TaskFlow - Auth Module (Professional)",
    "description": "Professional collection for Module 2 - Auth\nImport → set {{baseUrl}} → run in order\n\nSeeded demo:\n- SUPER_ADMIN: superadmin@gmail.com / Super@admin12345\n- Owner: owner@demo.com / Owner@123\n- Member: alice@demo.com / Member@123\n\nFlow: Register (OTP email) → Verify Email → Login → Me → Refresh (cookies) → Change Password → Forgot/Reset → Google → Logout\nCookies: accessToken (24h) + refreshToken (7d) httpOnly, secure:false, sameSite:none (healthcare style)\nNo rateLimit - cleaned",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "taskflow-auth-module-2"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "testEmail", "value": "testuser@example.com", "type": "string" },
    { "key": "otp", "value": "123456", "type": "string" },
    { "key": "resetOtp", "value": "123456", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET - Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "200 OK {success:true, data:{uptime}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Health 200',()=>pm.response.to.have.status(200));","var j=pm.response.json(); pm.test('success true',()=>pm.expect(j.success).to.eql(true));"] } }]
        },
        {
          "name": "GET - Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] },
            "description": "200 {message:\"TaskFlow API is running\"}"
          }
        }
      ]
    },
    {
      "name": "Register & Verify",
      "item": [
        {
          "name": "POST - Register (valid)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Test@1234\"\n}" },
            "description": "201 {user, message: OTP sent}. OTP 6-digit stored Redis EX 600 + cooldown 60. If not verified, re-register → 409 + resend OTP. Check server log / email / Redis for {{otp}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Register 201',()=>pm.response.to.have.status(201));","var j=pm.response.json(); pm.test('success',()=>pm.expect(j.success).to.eql(true));","if(j.data && j.data.user) console.log('User:', j.data.user.email);","console.log('Check OTP for', pm.variables.get('testEmail'));"] } }]
        },
        {
          "name": "POST - Register (validation 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"A\",\n  \"email\": \"bad\",\n  \"password\": \"weak\"\n}" },
            "description": "400 {success:false, errors:[{path,message}]} Zod"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400',()=>pm.response.to.have.status(400));","var j=pm.response.json(); pm.test('has errors',()=>pm.expect(j.errors.length).to.be.above(0));"] } }]
        },
        {
          "name": "POST - Verify Email (OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/verify-email", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","verify-email"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"otp\": \"{{otp}}\"\n}" },
            "description": "200 {accessToken, refreshToken, user} + Set-Cookie httpOnly. Test auto-saves tokens to {{accessToken}}/{{refreshToken}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var j=pm.response.json();","pm.test('Verify 200',()=>pm.response.to.have.status(200));","if(j.data && j.data.accessToken){","  pm.collectionVariables.set('accessToken', j.data.accessToken);","  pm.collectionVariables.set('refreshToken', j.data.refreshToken);","  console.log('Tokens saved');","}","if(j.data && j.data.user) pm.test('user returned',()=>pm.expect(j.data.user.email).to.eql(pm.variables.get('testEmail')));"] } }]
        },
        {
          "name": "POST - Verify Email (invalid OTP 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/verify-email", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","verify-email"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"otp\": \"000000\"\n}" },
            "description": "400 Invalid OTP or 400 OTP expired"
          }
        },
        {
          "name": "POST - Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/resend-otp", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","resend-otp"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\"\n}" },
            "description": "200 OTP resent. 429 if cooldown 60s active. 400 if already verified."
          }
        }
      ]
    },
    {
      "name": "Login",
      "item": [
        {
          "name": "POST - Login (Super Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"superadmin@gmail.com\",\n  \"password\": \"Super@admin12345\"\n}" },
            "description": "200 {user, accessToken, refreshToken} + cookies. Auto-saves tokens."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var j=pm.response.json();","pm.test('Login 200',()=>pm.response.to.have.status(200));","if(j.data && j.data.accessToken){","  pm.collectionVariables.set('accessToken', j.data.accessToken);","  pm.collectionVariables.set('refreshToken', j.data.refreshToken);","  console.log('SuperAdmin tokens saved');","}"] } }]
        },
        {
          "name": "POST - Login (Owner)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@demo.com\",\n  \"password\": \"Owner@123\"\n}" },
            "description": "200 Owner login - auto-saves tokens"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var j=pm.response.json();","if(j.data && j.data.accessToken){ pm.collectionVariables.set('accessToken', j.data.accessToken); pm.collectionVariables.set('refreshToken', j.data.refreshToken);}"] } }]
        },
        {
          "name": "POST - Login (Unverified → 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Test@1234\"\n}" },
            "description": "If not verified → 403 Email not verified + auto resend OTP (if cooldown passed)"
          }
        },
        {
          "name": "POST - Login (Wrong Pass 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@demo.com\",\n  \"password\": \"Wrong@123\"\n}" },
            "description": "401 Invalid credentials"
          }
        },
        {
          "name": "POST - Login (Validation 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"bad\",\n  \"password\": \"\"\n}" },
            "description": "400 Zod errors"
          }
        }
      ]
    },
    {
      "name": "Token & Me",
      "item": [
        {
          "name": "GET - Me (Bearer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","me"] },
            "description": "200 {user + memberships→organization}. Auth via Cookie accessToken OR Bearer header (authenticate middleware)"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Me 200',()=>pm.response.to.have.status(200));","var j=pm.response.json(); pm.test('has email',()=>pm.expect(j.data.email).to.be.a('string'));"] } }]
        },
        {
          "name": "GET - Me (No Token 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","me"] },
            "description": "401 You are not logged in"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401',()=>pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "POST - Refresh Token (cookies only - healthcare style)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","refresh-token"] },
            "body": { "mode": "raw", "raw": "{}" },
            "description": "Healthcare: reads req.cookies.refreshToken only (not body/header). Returns 200 + new cookies (secure:false, sameSite:none, maxAge 24h/7d) + {accessToken, refreshToken}. Send cookies from previous Login. Test auto-saves new tokens."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var j=pm.response.json();","pm.test('Refresh 200',()=>pm.response.to.have.status(200));","if(j.data && j.data.accessToken){","  pm.collectionVariables.set('accessToken', j.data.accessToken);","  pm.collectionVariables.set('refreshToken', j.data.refreshToken);","  console.log('Refreshed');","}"] } }]
        },
        {
          "name": "POST - Refresh Token (No Cookie 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","refresh-token"] },
            "body": { "mode": "raw", "raw": "{}" },
            "description": "401 Refresh token is missing (when cookie not sent). Disable cookie jar to test."
          }
        },
        {
          "name": "POST - Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","logout"] },
            "description": "200 clears httpOnly cookies accessToken + refreshToken (secure:false, sameSite:none). Client also clear Bearer."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Logout 200',()=>pm.response.to.have.status(200));","pm.collectionVariables.set('accessToken',''); pm.collectionVariables.set('refreshToken','');"] } }]
        }
      ]
    },
    {
      "name": "Password",
      "item": [
        {
          "name": "POST - Change Password (Bearer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","change-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"oldPassword\": \"Super@admin12345\",\n  \"newPassword\": \"Super@admin12345New@1\"\n}" },
            "description": "200 Password changed. 401 if old wrong, 400 if same. Google-only → 400. Requires authenticate."
          }
        },
        {
          "name": "POST - Change Password (Same → 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","change-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"oldPassword\": \"Test@1234\",\n  \"newPassword\": \"Test@1234\"\n}" },
            "description": "400 New password must be different"
          }
        },
        {
          "name": "POST - Forgot Password (Send OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\"\n}" },
            "description": "200 OTP sent to email. Redis EX 600 + cooldown 60. 429 if cooldown. Save OTP to {{resetOtp}}"
          }
        },
        {
          "name": "POST - Reset Password (OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","reset-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"otp\": \"{{resetOtp}}\",\n  \"newPassword\": \"NewPass@1234\"\n}" },
            "description": "200 Password reset successful. 400 if OTP expired/invalid. Then login with newPassword."
          }
        }
      ]
    },
    {
      "name": "Google",
      "item": [
        {
          "name": "POST - Google Login (valid idToken)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/google", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","google"] },
            "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"YOUR_GOOGLE_ID_TOKEN\"\n}" },
            "description": "200 + tokens if valid. Verifies via google-auth-library audience GOOGLE_CLIENT_ID. Links by googleId/email, auto verifies email. Alias: POST /social-login same body."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var j=pm.response.json();","if(j.data && j.data.accessToken){ pm.collectionVariables.set('accessToken', j.data.accessToken); pm.collectionVariables.set('refreshToken', j.data.refreshToken);}"] } }]
        },
        {
          "name": "POST - Google Login (invalid → 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/google", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","google"] },
            "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"invalidtoken12345\"\n}" },
            "description": "401 Invalid or expired Google ID token"
          }
        },
        {
          "name": "POST - Social Login Alias",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/social-login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","social-login"] },
            "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"YOUR_GOOGLE_ID_TOKEN\"\n}" },
            "description": "Same as /google"
          }
        }
      ]
    }
  ]
}