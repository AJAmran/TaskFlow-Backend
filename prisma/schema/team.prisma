model Team {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  members      TeamMember[]
  projects     Project[]

  @@index([organizationId])
  @@map("teams")
}