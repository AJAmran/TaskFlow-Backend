model Attachment {
  id         String   @id @default(uuid())
  taskId     String
  url        String
  publicId   String?
  fileName   String
  uploadedBy String
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@index([uploadedBy])
  @@map("attachments")
}