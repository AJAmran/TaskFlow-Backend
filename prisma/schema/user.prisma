model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password      String?
  provider      String        @default("credentials")
  platformRole  PlatformRole  @default(USER)
  isActive      Boolean       @default(true)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([email])
}