model Subtask {
  id        String    @id @default(uuid())
  taskId    String
  title     String
  isDone    Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@map("subtasks")
}